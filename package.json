{
  "name": "tea-qa-monorepo",
  "private": true,
  "description": "TEA: Test Everything Automatically. Spill the TEA on your app.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "tsc -b --clean",
    "tea": "node packages/cli/dist/bin.js",
    "browsers": "playwright install chromium",
    "demo": "node scripts/demo.mjs",
    "example:build": "npm run build -w buggy-next-app",
    "example:start": "npm run start -w buggy-next-app",
    "verify:example": "node scripts/verify-example.mjs",
    "start": "npm run build --silent && node packages/cli/dist/bin.js run"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "playwright": "^1.49.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^7.3.7",
    "vitest": "^5.0.5"
  },
  "workspaces": [
    "packages/core",
    "packages/repo-map",
    "packages/scanner",
    "packages/report",
    "packages/cli",
    "examples/*"
  ]
}
