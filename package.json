{
  "name": "tea-qa",
  "version": "0.1.0",
  "description": "TEA (Test Everything Automatically): the free, open-source QA tester for vibe-coded apps. Point it at your URL and code; get a plain-English report, a quality gate and fix prompts for your AI coding agent.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "tea-qa": "dist/cli/bin.js",
    "tea": "dist/cli/bin.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "checks",
    "theme",
    "web/app",
    "web/components",
    "web/lib",
    "web/public",
    "web/proxy.ts",
    "web/next.config.ts",
    "web/package.json",
    "web/tsconfig.json",
    "web/.next",
    "!web/.next/cache",
    "!web/.next/dev"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "qa",
    "testing",
    "test-automation",
    "e2e",
    "playwright",
    "quality-gate",
    "static-analysis",
    "security",
    "accessibility",
    "api-testing",
    "vibe-coding",
    "ai",
    "nextjs",
    "sonarqube-alternative",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/deepbratt/TEA.git"
  },
  "workspaces": [
    "examples/*",
    "web"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "start": "node scripts/start.mjs",
    "ui": "node scripts/start.mjs",
    "tea": "node dist/cli/bin.js",
    "browsers": "playwright install chromium",
    "demo": "node scripts/demo.mjs",
    "example:build": "npm run build -w buggy-next-app",
    "example:start": "npm run start -w buggy-next-app",
    "verify:example": "node scripts/verify-example.mjs",
    "knip": "knip",
    "build:web": "npm run build -w tea-workbench",
    "ui:dev": "npm run build --silent && node scripts/workbench-dev.mjs"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "commander": "^12.1.0",
    "next": "^16.4.2",
    "playwright": "^1.49.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "yaml": "^2.6.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "axe-core": "^4.14.0",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "knip": "^6.42.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^7.3.7",
    "vitest": "^5.0.5"
  },
  "author": {
    "name": "DeepBratt",
    "url": "https://github.com/deepbratt"
  },
  "homepage": "https://github.com/deepbratt/TEA#readme",
  "bugs": {
    "url": "https://github.com/deepbratt/TEA/issues"
  }
}
