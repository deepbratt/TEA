  },
  "dependencies": {
    "@tea-qa/scanner": "0.1.0",
    "@tea-qa/core": "0.1.0",
    "@tea-qa/report": "0.1.0",
    "@tea-qa/repo-map": "0.1.0",
    "commander": "^12.1.0"
