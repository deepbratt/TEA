{
  "name": "tea-qa",
  "version": "0.1.0",
  "description": "TEA: Test Everything Automatically. Spill the TEA on your app.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "tea-qa": "dist/bin.js",
    "tea": "dist/bin.js"
